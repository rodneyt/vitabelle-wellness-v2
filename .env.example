# === Cloudflare Secrets (set via `wrangler secret put`) ===
ENCRYPTION_KEY=           # Base64-encoded 256-bit key for AES-256-GCM
HMAC_KEY=                 # Base64-encoded 256-bit key for HMAC-SHA256
TURNSTILE_SECRET_KEY=     # Cloudflare Turnstile secret key
PDF_SIGNING_SECRET=       # Secret for HMAC-signed PDF download URLs

# === Fase 2 (email) ===
# GMAIL_SERVICE_ACCOUNT=  # Google Workspace service account JSON (base64)
# BUSINESS_EMAIL=         # Email para enviar/recibir PDFs

# === wrangler.toml [vars] ===
TURNSTILE_SITE_KEY=       # Cloudflare Turnstile site key (public)
BUSINESS_NAME=            # Business display name
SITE_URL=                 # Production URL

# === Cloudflare Resources ===
# D1 Database: vitabelle-crm (binding: DB)
# R2 Bucket: vitabelle-pdfs (binding: PDF_BUCKET)
